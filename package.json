{
  "name": "seniorapi",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "imports": {
    "#config/*": "./src/config/*",
    "#controllers/*": "./src/config/*",
    "#middleware/*": "./src/config/*",
    "#models/*": "./src/config/*",
    "#services/*": "./src/config/*",
    "#utils/*": "./src/config/*",
    "#validations/*": "./src/config/*"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "lint": "./node_modules/.bin/eslint .",
    "lint:fix": "./node_modules/.bin/eslint . --fix",
    "format": "./node_modules/.bin/prettier --write .",
    "format:check": "./node_modules/.bin/prettier --check .",
    "db:generate": "./node_modules/.bin/drizzle-kit generate",
    "db:migrate": "./node_modules/.bin/drizzle-kit migrate",
    "db:studio": "./node_modules/.bin/drizzle-kit studio",
    "dev:docker": "sh scripts/dev.sh",
    "prod:docker": "sh scripts/prod.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GiannisWare/seniorapi.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/GiannisWare/seniorapi/issues"
  },
  "homepage": "https://github.com/GiannisWare/seniorapi#readme",
  "dependencies": {
    "@arcjet/inspect": "^1.10.0",
    "@arcjet/node": "^1.10.0",
    "@neondatabase/serverless": "^1.1.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6"
  }
}
